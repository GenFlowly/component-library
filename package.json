{
  "name": "@genflowly/component-library",
  "version": "0.1.141",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "main": "dist/bundle.js",
  "module": "dist/bundle.js",
  "types": "dist/types/index.d.ts",
  "repository": {
    "url": "git://github.com/genflowly/component-library.git"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx}' --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "build": "webpack && tsc --emitDeclarationOnly",
    "release": "webpack && tsc --emitDeclarationOnly",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "if [ -z \"$CI\" ]; then husky install; fi",
    "format": "prettier --write .",
    "pre-commit": "npx lint-staged && jest && tsc --noEmit",
    "check-format": "prettier --check ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.tsx"
        ],
        "rules": {
          "testing-library/no-node-access": "off",
          "testing-library/no-container": "off",
          "testing-library/no-unnecessary-act": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.8",
    "@dagrejs/dagre": "^3.1.1",
    "@uiw/react-markdown-editor": "^6.1.4",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@xyflow/react": "^12.11.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.7",
    "lucide-react": "^0.548.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-i18next": ">=14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-webpack5": "8.6.18",
    "@storybook/test": "8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.11",
    "@types/node": "20.1.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.18",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "circular-dependency-plugin": "^5.2.2",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.9.1",
    "eslint": "^8.56.0",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^8.0.3",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "identity-obj-proxy": "^3.0.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.9",
    "mini-css-extract-plugin": "^2.9.0",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "sass": "^1.93.2",
    "sass-loader": "^14.2.1",
    "source-map-loader": "^5.0.0",
    "storybook": "8.6.19",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@genflowly"
  },
  "overrides": {
    "katex": "$katex"
  }
}
